{
  "expo": {
    "name": "Lapor Kampus",
    "slug": "lapor-kampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.laporkampus",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.laporkampusnative",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi membutuhkan akses kamera untuk memotret bukti fasilitas yang rusak.",
        "NSLocationWhenInUseUsageDescription": "Aplikasi membutuhkan koordinat GPS untuk mendeteksi posisi kerusakan fasilitas kampus."
      }
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Aplikasi membutuhkan akses kamera untuk memotret bukti fasilitas yang rusak."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ]
  }
}
